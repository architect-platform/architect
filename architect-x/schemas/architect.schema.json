{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architect Configuration",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Project name" },
        "type": { "type": "string", "enum": ["application", "library", "workspace"], "default": "application" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name"]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "config": { "type": "object" },
          "enabled": { "type": "boolean" }
        },
        "required": ["id"]
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/action"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/rule"
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "environments": {
      "type": "object"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "members": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cloud": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "org": { "type": "string" }
      }
    }
  },
  "definitions": {
    "action": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "plugin": { "type": "string" },
        "run": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "working_dir": { "type": "string" },
            "shell": { "type": "string" }
          },
          "required": ["command"]
        },
        "steps": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "attach_to": { "type": "string" },
        "parallel": { "type": "boolean" },
        "condition": { "type": "string" },
        "continue_on_error": { "type": "boolean" },
        "retry": {
          "type": "object",
          "properties": {
            "count": { "type": "integer" },
            "delay": { "type": "string" },
            "backoff": { "type": "string", "enum": ["linear", "exponential"] }
          }
        },
        "timeout": { "type": "string" },
        "cache": {
          "type": "object",
          "properties": {
            "key": { "type": "string" },
            "paths": { "type": "array", "items": { "type": "string" } }
          }
        },
        "inputs": { "type": "object" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rule": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warn", "info"] },
        "trigger": { "type": "array", "items": { "type": "string" } },
        "check": {
          "type": "object",
          "properties": {
            "command": { "type": "string" }
          }
        },
        "fix": {
          "type": "object",
          "properties": {
            "command": { "type": "string" }
          }
        },
        "condition": { "type": "string" },
        "rationale": { "type": "string" },
        "pattern": {
          "type": "object",
          "properties": {
            "exists": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
